{
  "name": "sharvi-aggarwal-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node --experimental-sqlite --no-warnings server/index.mjs",
